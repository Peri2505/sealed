# ---- PayPal (sandbox) ----
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the PayPal dashboard (enables signature verification)
PAYPAL_WEBHOOK_ID=
# Optional: send the seller's share with the Payouts API after capture ("true" to enable)
PAYPAL_PAYOUTS_ENABLED=false

# ---- AI (Anthropic Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- App ----
# Optional public URL of the app for share links (no trailing slash). Detected automatically if empty.
APP_URL=http://localhost:3000
# Where deals are stored (JSON file). Use a persistent disk path in production.
DATA_DIR=.data
# Minimum AI confidence (0-1) required to release money automatically
AUTO_RELEASE_CONFIDENCE=0.8
